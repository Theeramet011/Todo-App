// ============================================================================
// ไฟล์นี้เปรียบเสมือน "ยามเฝ้าโกดังเก็บของ (Storage Rules)" ของ Firebase Storage
// ทำหน้าที่กำหนดสิทธิ์ว่าใครสามารถเข้ามา อัปโหลด (write) หรือ ดาวน์โหลด (read)
// ไฟล์รูปโปรไฟล์ ไฟล์แนบ หรือไฟล์อื่นๆ ในระบบได้บ้าง และจำกัดขนาดของไฟล์ได้
// ============================================================================
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. รูปโปรไฟล์ (Avatars): ผู้ใช้ทั่วไปสามารถดูรูปได้ แต่จะอัปโหลดได้เฉพาะรูปของตัวเอง (ต้องล็อกอิน)
    // และจำกัดขนาดรูปต้องไม่เกิน 10MB รวมถึงต้องเป็นไฟล์ประเภทรูปภาพเท่านั้น
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName.split('\\.')[0] == request.auth.uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 2. ไฟล์แนบและรูปในคอมเมนต์ของภารกิจ (Tasks): 
    // เฉพาะผู้ที่ล็อกอินแล้วเท่านั้นถึงจะสามารถดูและอัปโหลดไฟล์ในส่วนของงานได้
    match /tasks/{taskId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // 3. ปิดกั้นการเข้าถึงที่เหลือทั้งหมด: (เพื่อความปลอดภัย) 
    // หากมีการเข้าถึงโฟลเดอร์อื่นที่ไม่ได้ระบุไว้ด้านบน จะถูกปฏิเสธทันที
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
